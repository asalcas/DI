<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI.MainPage"
             
             
             
             xmlns:vm="clr-namespace:MAUI.Models">
    <!-- Si quisiera importar un elemento de otro proyecto (Biblioteca de clases) a esta, escribiriamos: xmlns:(variable)="clr-namespace:(DONDE ESTE, BL POR EJEMPLO);assembly=BL" -->
            

    <ContentPage.BindingContext>
        <vm:ListadoPersonaConCheckVM/>
    </ContentPage.BindingContext>

    <ScrollView>
        <ListView ItemsSource="{Binding ListaConCheck}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame 
                        Padding="10" 
                        Margin="5" 
                        CornerRadius="15" 
                        BackgroundColor="White" 
                        HasShadow="True" 
                        BorderColor="Green">
                            <StackLayout 
                            Orientation="Horizontal" 
                            Spacing="15"
                            VerticalOptions="CenterAndExpand">

                                <!-- Etiqueta para el Nombre -->
                                <Label 
                                Text="{Binding Nombre}" 
                                VerticalOptions="Center" 
                                HorizontalOptions="StartAndExpand" 
                                FontSize="Medium" 
                                FontAttributes="Bold"
                                TextColor="Green"/>

                                <!-- Etiqueta para el Apellido -->
                                <Label 
                                Text="{Binding Apellido}" 
                                VerticalOptions="Center" 
                                HorizontalOptions="StartAndExpand" 
                                FontSize="Medium" 
                                TextColor="DimGrey" />

                                <!-- Checkbox para mostrar si es mayor de edad -->
                                <CheckBox 
                                IsEnabled="False" 
                                IsChecked="{Binding EsMayor}" 
                                VerticalOptions="Center" 
                                Color="LightGreen" 
                                HorizontalOptions="End" />
                            </StackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </ScrollView>

</ContentPage>
